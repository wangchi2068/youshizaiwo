# 复制为 .env 并填写（.env 已被 gitignore，勿提交）
WANGDACHUI_API_BASE=https://tokenrhythm.studio/v1
WANGDACHUI_API_KEY=你的_API_Key
WANGDACHUI_MODEL=deepseek-v4-flash-0731

# 可选：兜底 provider（主 provider 不可达 / 5xx / 401·403·404 时自动切到下一家）
# 同一 provider 不同 key 可作为"配额分流"型兜底：主 key 跑满后自动切到备 key
# WANGDACHUI_FALLBACK_API_BASE=https://tokenrhythm.studio/v1
# WANGDACHUI_FALLBACK_API_KEY=sk_tr_xxx
# WANGDACHUI_FALLBACK_API_MODEL=deepseek-v4-flash-0731
# 多个兜底写法（JSON 数组，依次回退；可混不同 provider）：
# WANGDACHUI_FALLBACKS_JSON=[{"apiBase":"https://tokenrhythm.studio/v1","apiKey":"sk_tr_xxx","model":"deepseek-v4-flash-0731"}]
# 调试：禁用兜底强制走主 provider（便于复现主 provider 故障）
# WANGDACHUI_DISABLE_FALLBACK=1

# 可选：模型分级——记账/压缩用更便宜的模型（缺省跟随主模型）
# WANGDACHUI_SCRIBE_MODEL=deepseek-v4-flash-0731
# WANGDACHUI_COMPRESS_MODEL=deepseek-v4-flash-0731
# 可选：上下文预算（字符，默认 24000 ≈ 8k token）
# WANGDACHUI_CONTEXT_BUDGET_CHARS=24000
# 可选：agent 循环上限（默认 10）
# WANGDACHUI_MAX_LOOP_TURNS=10

# ── 回合配图（正文出完后异步生成一张插画，不阻塞对话）────────────────
# 默认开启，设 0 关闭（关闭后每回合不再调图像模型，省钱）
# WANGDACHUI_ILLUSTRATION=1
# 出图模型（走 OpenAI 兼容的 /images/generations；需与主 provider 同一网关或可访问）
# 默认 gemini-3.1-flash-lite-image：实测约 6s、816KB，画质与 2.5 版同级（最快最省）
# 备选 gemini-2.5-flash-image（约 7-23s、1.6MB，上游负载好时也很快，波动大）
#      gemini-3.1-flash-image（约 11s、828KB，画风偏 3D）
# 注意：flux / sd3.5-turbo / doubao-seedream 在该网关实测 404/429/503，用不了
# WANGDACHUI_ILLUSTRATION_MODEL=gemini-3.1-flash-lite-image
# 出图尺寸（注意：部分网关会忽略此参数、始终返回 1024x1024 方形图）
# WANGDACHUI_ILLUSTRATION_SIZE=1024x1024
# 提炼画面描述用的模型（默认 qwen-flash，约 2.4s）
# 注意：别用思考型模型（如 gemini-3.8-flash）——它会把输出预算烧在思维链上，
# 实测 289/296 的 token 用于推理，画面描述只剩十个字，出的图就只剩空镜。
# WANGDACHUI_ILLUSTRATION_PROMPT_MODEL=qwen-flash
# 每会话出图上限，0 = 不限（默认 30，防演示时额度被烧穿）
# WANGDACHUI_ILLUSTRATION_MAX=30
# 全局每日出图上限，0 = 不限（默认 150；公开链接被人连点的兜底保险）
# WANGDACHUI_ILLUSTRATION_DAILY_MAX=150
# 单张图超时（毫秒，默认 60000；上游负载差时能到 20s+，别设太紧）
# WANGDACHUI_ILLUSTRATION_TIMEOUT_MS=60000
